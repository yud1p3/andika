# === Gemini (wajib) ===
# Ambil dari https://aistudio.google.com -> Get API Key
GEMINI_API_KEY=

# Model Gemini untuk menyusun jawaban.
# Notebook memakai gemini-2.5-flash-lite, tapi model itu sudah ditutup untuk
# pengguna baru ("no longer available to new users"). Ini penggantinya.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Model embedding. Di notebook: gemini-embedding-2
# Kalau API menolak nama ini, ganti ke: gemini-embedding-001
GEMINI_EMBED_MODEL=gemini-embedding-2

# Dimensi vector. Di notebook: 768
GEMINI_EMBED_DIM=768

# === Penyedia chat (opsional) ===
# CHAT_PROVIDER menentukan backend untuk chat model. Embedding tidak ikut
# beralih: keduanya selalu lewat API resmi Google, karena antarmuka web Gemini
# tidak menyediakan endpoint embedding. Jadi GEMINI_API_KEY tetap wajib.
#
#   gemini (default) API resmi Google, memakai GEMINI_API_KEY di atas.
#
#   openai           endpoint OpenAI-compatible. Dipakai untuk mengalihkan
#                    chat ke proxy seperti gemini-web2api, yang membungkus
#                    antarmuka web Gemini. Lihat bagian "Mode proxy" di README
#                    sebelum memakainya: tool calling di jalur ini lebih rapuh
#                    karena bukan function calling asli.
CHAT_PROVIDER=gemini

# Alamat dasar endpoint OpenAI-compatible. Harus memuat versi API ("/v1"),
# karena yang ditambahkan hanya path relatif "/chat/completions".
# Dipakai hanya ketika CHAT_PROVIDER=openai.
CHAT_BASE_URL=http://localhost:8081/v1

# Kunci untuk endpoint OpenAI-compatible. Ini kunci lokal proxy, bukan kunci
# Google, jadi aman disimpan di .env.
# Dipakai hanya ketika CHAT_PROVIDER=openai.
CHAT_API_KEY=sk-gemini

# CATATAN: ketika CHAT_PROVIDER=openai, GEMINI_CHAT_MODEL di atas harus diisi
# nama model yang dikenali proxy (mis. gemini-3.6-flash), bukan nama model API
# Google. Lihat daftar model lewat:
#   curl -H "Authorization: Bearer sk-gemini" http://localhost:8081/v1/models

# === Qdrant ===
# PENTING: 6334 adalah port gRPC yang dipakai Go client Qdrant.
# 6333 adalah port REST (dipakai untuk cek manual via curl).
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=perbup_18_2025

# === Kode klasifikasi (opsional) ===
# Fitur rekomendasi kode klasifikasi di client web: pengguna mengetik
# KK#perihal naskah#, perihalnya di-embed, lalu dicocokkan dengan kode yang
# sudah disalin ke Qdrant. Lihat README, bagian "Rekomendasi kode klasifikasi".
#
# Perintah "rag impor-kode" menyalin kode beserta VEKTORNYA dari PostgreSQL ke
# Qdrant — tidak ada embed ulang, jadi tidak memakan kuota. Syaratnya vektor di
# PostgreSQL dibuat dengan model, dimensi, dan TaskType yang sama dengan proyek
# ini:
#   gemini-embedding-2, 768 dimensi (GEMINI_EMBED_DIM), RETRIEVAL_DOCUMENT.
# Dimensi yang berbeda ditolak saat impor; model/TaskType yang berbeda tidak
# bisa dideteksi otomatis — hasilnya akan tampak jalan tapi tidak akurat.
#
# String koneksi PostgreSQL. Dibaca hanya oleh "rag impor-kode"; "ask" dan
# "serve" tidak menyentuh database sama sekali.
DATABASE_URL=

# Collection Qdrant khusus kode klasifikasi, terpisah dari QDRANT_COLLECTION.
QDRANT_COLLECTION_KODE=kode_klasifikasi

# Tabel dan kolom sumber di PostgreSQL. Nama harus identifier sederhana
# (huruf, angka, garis bawah); nama bertitik seperti "skema.tabel" tidak
# diterima. Nilai di bawah mengikuti skema yang dipakai proyek ini; sesuaikan
# bila tabel Anda berbeda.
#
# KODE_KOLOM_ID harus kunci unik (biasanya primary key), karena kolom kode
# TIDAK unik: satu kode bisa dipakai beberapa item. Memakai kode sebagai ID
# titik Qdrant akan membuat baris-baris itu saling menimpa.
#
# KODE_KOLOM_PATH adalah hierarki lengkap ("A > B > C"). Kolom inilah yang
# di-embed saat vektor dibuat, jadi ia yang harus disalin/dicocokkan.
KODE_TABEL=klasifikasi_embedding
KODE_KOLOM_ID=id
KODE_KOLOM_KODE=kode
KODE_KOLOM_URAIAN=deskripsi
KODE_KOLOM_VEKTOR=embedding
KODE_KOLOM_PATH=path

# Jumlah kandidat kode yang diambil dari Qdrant lalu diserahkan ke model.
KODE_TOP_K=10

# === Sumber dokumen ===
# DOC_PATH menentukan dokumen yang jadi sumber pengetahuan. Ekstensi berkasnya
# menentukan cara membacanya:
#   .pdf  -> di-parse sebagai PDF, satu Document per halaman
#   lainnya (.md, .txt) -> dibaca sebagai teks apa adanya
#
# Dokumen contoh di repo ini: PERBUP Kabupaten Blitar Nomor 18 Tahun 2025
# tentang Tata Naskah Dinas. PDF-nya dikonversi dulu ke Markdown dengan xberg
# supaya judul dan tabelnya terjaga, lalu Markdown itulah yang di-ingest:
#
#   xberg extract data/perbup_18_2025.pdf --content-format markdown \
#     --disable-ocr true --pdf-extract-tables false > data/perbup_18_2025.md
#
# --pdf-extract-tables false wajib untuk dokumen ini. Tanpa itu xberg salah
# mengira paragraf biasa sebagai tabel dua kolom, sehingga Pasal 25 dan 131
# kehilangan penandanya dan prosanya tercabik jadi sel. Alasannya lengkap ada
# di README, bagian "Mengganti dokumen".
DOC_PATH=data/perbup_18_2025.md

# DOC_URL opsional: kalau diisi dan DOC_PATH belum ada, dokumennya diunduh
# dulu. Dikosongkan berarti dokumen dianggap sudah disiapkan lokal.
DOC_URL=

# === Tampilan web ===
# Judul dan keterangan di kepala halaman "rag serve".
APP_TITLE=ANDIKA — Asisten Naskah Dinas & Klasifikasi Arsip
APP_SUBTITLE=Tata Naskah Dinas & Kode Klasifikasi Arsip

# === Chunking ===
# CHUNK_STRATEGY menentukan cara dokumen dipotong:
#
#   pasal     (default) memotong pada batas Pasal, dan hanya memecah lebih
#             lanjut kalau satu pasal tidak muat. Setiap potongan diberi header
#             rujukan ("Pasal 1 angka (6)-(7)") supaya pasalnya tetap bisa
#             ditemukan. Ini yang dipakai untuk dokumen peraturan.
#
#   recursive memotong berdasarkan ukuran saja, mengikuti pemisah default
#             ["\n", ".", "?", "!"] — cara notebook. Cocok untuk dokumen yang
#             tidak berstruktur pasal.
#
# Mengubah nilai ini mengubah semua ID chunk, jadi data lama di Qdrant tidak
# lagi tertimpa. Jalankan "rag ingest" ulang setelah mengubahnya.
CHUNK_STRATEGY=pasal

# CHUNK_SIZE adalah ambang pemecahan, bukan ukuran pasti. Pada strategi
# "pasal": pasal yang muat dibiarkan utuh, yang lebih panjang dipecah pada
# batas ayat/butir. Pada strategi "recursive": ukuran maksimum tiap potongan.
CHUNK_SIZE=500

# CHUNK_OVERLAP hanya dipakai strategi "recursive". Pada strategi "pasal"
# tidak berpengaruh: potongan tidak dibuat tumpang tindih.
CHUNK_OVERLAP=100

# === Retrieval ===
# Parameter "k" di notebook
TOP_K=10

# === Memori percakapan ===
# Jumlah pesan riwayat (tanya + jawab) yang disertakan pada giliran berikutnya,
# sehingga rujukan seperti "naskah poin a di atas" tetap dipahami.
#   6 = 3 giliran tanya-jawab terakhir (default)
#   0 = memori dimatikan, setiap pertanyaan dijawab lepas
# Berlaku untuk "rag ask" maupun "rag serve".
HISTORY_MESSAGES=6

# === Saran pertanyaan lanjutan (khusus web) ===
# Jumlah tombol pertanyaan lanjutan yang disusun model setelah sebuah jawaban.
# Tiap saran berarti satu panggilan model tambahan per jawaban, yang berjalan
# bersamaan dengan jawaban sehingga biasanya tidak terasa.
#   3 = tiga tombol (default)
#   0 = fitur dimatikan, tidak ada tombol dan tidak ada panggilan model kedua
# Hanya dipakai "rag serve"; "rag ask" tidak terpengaruh.
SARAN_COUNT=3

# === Mode agen (eksperimental) ===
# AGENT_MODE mengganti jalur jawab dari chain linear menjadi agen ReAct.
#
#   false (default) chain linear: satu kali retrieval, satu kali model menjawab.
#                   Cepat, deterministik, dan jadi jalur cepat bawaan.
#
#   true            agen ReAct: model memilih sendiri tool mana yang dipanggil
#                   (cari_vektor, baca_pasal, ikuti_rujukan) dan boleh
#                   retrieval berkali-kali sebelum menjawab. Lebih fleksibel
#                   untuk pertanyaan berlapis, tapi lebih lambat dan memakai
#                   lebih banyak kuota.
#
# Bila agen gagal sebelum mengeluarkan potongan jawaban pertama, jawaban
# otomatis diambil alih chain linear — pengguna tetap dapat jawaban.
AGENT_MODE=false

# AGENT_MAX_STEP membatasi jumlah langkah agen. Satu panggilan model atau satu
# pemanggilan tool dihitung satu langkah.
#   8 = kira-kira cukup untuk baca_pasal -> ikuti_rujukan -> jawab (default)
# Habis langkah berarti agen berhenti dan permintaan jatuh ke chain linear.
AGENT_MAX_STEP=8

# AGENT_TIMEOUT_SECONDS adalah jaring pengaman waktu untuk satu permintaan di
# jalur agen. Batas yang sebenarnya adalah AGENT_MAX_STEP; nilai ini hanya
# mencegah satu permintaan menggantung tanpa batas. Hanya berlaku di mode agen.
AGENT_TIMEOUT_SECONDS=90
